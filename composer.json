{
    "name": "nomansheikh/laravel-bigquery-eloquent",
    "description": "Query Google BigQuery tables with Laravel Eloquent.",
    "keywords": [
        "Noman Sheikh",
        "laravel",
        "laravel-bigquery-eloquent"
    ],
    "homepage": "https://github.com/nomansheikh/laravel-bigquery-eloquent",
    "license": "MIT",
    "authors": [
        {
            "name": "Noman Sheikh",
            "email": "hey@noman.codes",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "google/cloud-bigquery": "^1.35",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "11.*",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-arch": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "NomanSheikh\\LaravelBigqueryEloquent\\": "src/",
            "NomanSheikh\\LaravelBigqueryEloquent\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NomanSheikh\\LaravelBigqueryEloquent\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-smoke": "@php tests/smoke.php",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NomanSheikh\\LaravelBigqueryEloquent\\LaravelBigqueryEloquentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
