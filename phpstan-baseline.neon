parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 3
			path: config/bigquery-eloquent.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Connection\:\:getDefaultDataset\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Eloquent/BigQueryModel.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Connection\:\:getProjectId\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Eloquent/BigQueryModel.php

		-
			message: '#^Parameter \#1 \$connection of class NomanSheikh\\LaravelBigqueryEloquent\\Query\\BigQueryQueryBuilder constructor expects NomanSheikh\\LaravelBigqueryEloquent\\BigQueryConnection, Illuminate\\Database\\Connection given\.$#'
			identifier: argument.type
			count: 1
			path: src/Eloquent/BigQueryModel.php

		-
			message: '#^Method NomanSheikh\\LaravelBigqueryEloquent\\Query\\BigQueryQueryBuilder\:\:get\(\) should return Illuminate\\Support\\Collection\<int, stdClass\> but returns Illuminate\\Support\\Collection\<\(int\|string\), array\<mixed, mixed\>\>\.$#'
			identifier: return.type
			count: 1
			path: src/Query/BigQueryQueryBuilder.php
